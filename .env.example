# Example only: the application does not load this file automatically.
# Keep the current local provider unless the owner explicitly chooses a paid API.
OFFICE_PROVIDER=ollama
OFFICE_MODEL=qwen3:4b-instruct-2507-q4_K_M
OFFICE_OLLAMA_URL=http://127.0.0.1:11434
OFFICE_MODEL_RETRIES=0

