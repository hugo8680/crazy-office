# Container variant. Supply OFFICE_API_UPSTREAM=office-server:8080.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    include /etc/nginx/mime.types;
    types { text/javascript mjs; }
    client_max_body_size 12M;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header Cache-Control "no-cache";
    location ^~ /api/ {
        proxy_pass http://${OFFICE_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_send_timeout 60s;
    }
    location = /login { return 302 /; }
    location = /login.html { return 302 /; }
    location = /join { try_files /index.html =404; }
    location = /join.html { try_files /index.html =404; }
    location ~ /\. { deny all; }
    location ~* \.(?:css|js|mjs|svg|png|jpg|jpeg|webp|gif|ico|woff|woff2|ttf)$ { try_files $uri =404; }
    location = /asset-manifest.json { try_files $uri =404; }
    location / {
        # Static scene only. /api retains the Go authentication boundary.
        try_files $uri $uri/ =404;
    }
}
