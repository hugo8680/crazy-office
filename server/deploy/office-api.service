[Unit]
Description=Crazy Office Go API
After=network-online.target office-model.service
Wants=network-online.target
[Service]
Type=simple
User=office-lab
Group=office-lab
WorkingDirectory=/opt/office.laisengou.com/server/current
EnvironmentFile=/opt/office.laisengou.com/office.env
# env applies these three runtime values after the existing private EnvironmentFile.
# This preserves model/authentication variables while replacing the old PORT=4173.
ExecStart=/usr/bin/env HOST=127.0.0.1 PORT=8080 OFFICE_DATA_DIR=/opt/office.laisengou.com/data /opt/office.laisengou.com/server/current/office-api
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/office.laisengou.com/data
MemoryMax=2G
CPUQuota=200%
TasksMax=128
[Install]
WantedBy=multi-user.target
