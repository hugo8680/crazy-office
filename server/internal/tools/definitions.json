                  "type": "string"
                },
                "description": "依赖的工作包ID数组"
              },
              "requirementIds": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "覆盖的需求ID"
              },
              "deliverable": {
                "type": "string",
                "description": "可验收产物"
              }
            },
            "additionalProperties": false
          }
        },
        "dailyRate": {
          "type": "number",
          "description": "可省略，使用用户人日单价"
        },
        "teamSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "bufferPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "仅费用缓冲比例，不增加排期。时间缓冲尚未建模，不能声称已预留时间。"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "估算假设"
        }
      },
      "additionalProperties": false
    }
