                "type": "string",
                "description": "可核验验收条件"
              }
            },
            "additionalProperties": false
          }
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "数据实体/业务对象"
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "待真人确认的问题"
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "本次排除范围"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "明确标记假设"
        }
