  {
    "name": "test_database",
    "description": "真实检查SQLite完整性/外键与结构，并自动独立复跑input.databaseChecks。已有合同不必重复传tests；可传tests:[]和queries。附加正反用例可用setupSql准备本用例前置数据，不能把已回滚合同ID当现存样本；期望约束拒绝用expectError:true。queries只允许SELECT，全部测试变更回滚。",
    "parameters": {
      "type": "object",
      "properties": {
        "tests": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "验收条件"
              },
              "setupSql": {
                "type": "string",
                "description": "可选，本用例SQL执行前的准备语句，完成后一起回滚；准备失败不能算约束通过"
              },
              "sql": {
                "type": "string",
                "description": "INSERT/UPDATE/DELETE/SELECT测试SQL"
              },
              "expectError": {
                "type": "boolean"
              },
              "expectedRows": {
                "type": "integer"
              },
              "params": {
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "number",
                    "null"
                  ]
                }
              }
            },
            "additionalProperties": false
          }
        },
        "queries": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "extract_requirements",
