# Example only: the application does not load this file automatically.
# Existing deployment uses direct DashScope. Supply the key through a private
# 0600 environment file; never add a real key here or in the client project.
HOST=127.0.0.1
PORT=8080
OFFICE_DATA_DIR=.office-data
OFFICE_PROVIDER=dashscope
OFFICE_MODEL=qwen3.7-plus-2026-05-26
OFFICE_DASHSCOPE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_API_KEY=<server-side-only>
OFFICE_MODEL_TIMEOUT_MS=180000

# Existing Codex login or a local Ollama model can be explicitly selected.
# OFFICE_PROVIDER=codex
# OFFICE_PROVIDER=ollama
# OFFICE_OLLAMA_URL=http://127.0.0.1:11434
# OFFICE_MODEL=<installed-model-name>

# Required for a public deployment; reuse the existing private configuration.
# OFFICE_PUBLIC_ORIGIN=https://office.laisengou.com
# OFFICE_ACCESS_USERNAME=office
# OFFICE_ACCESS_PASSWORD_HASH=<scrypt-hash>
# OFFICE_SESSION_SECRET=<private-random-secret>
